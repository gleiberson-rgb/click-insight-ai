# === Template de secrets para Streamlit Community Cloud ===
# Em PRODUCAO no Streamlit Cloud, voce NAO cria este arquivo —
# voce cola estes valores no painel web (Settings → Secrets).
# Este arquivo so existe para documentar quais variaveis sao necessarias.
#
# Em DESENVOLVIMENTO LOCAL, voce pode copiar este arquivo para
# .streamlit/secrets.toml (sem o .example) com os valores reais.
# Esse arquivo .streamlit/secrets.toml esta no .gitignore.

HUBSPOT_TOKEN = "pat-na1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
